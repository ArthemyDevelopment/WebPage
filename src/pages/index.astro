</DefaultLayout>

<style>
  .avatar {
    border: 1px solid var(--border-color-subtle);
    border-radius: var(--radius-md);
    padding: var(--space-s);
  }

  .container .desc{
    font-size: 1rem;
    text-align: justify;
    padding-left: 25px;
    padding-right: 25px;
    padding-bottom: 20px;
    
  }
</style>
