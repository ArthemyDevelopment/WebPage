---
import DefaultLayout from '@layouts/DefaultLayout.astro'
import Hero from '@components/Hero.astro'
import Feature from '@components/Feature.astro'
import Counter from '@components/Counter.astro'
import ContentMedia from '@components/ContentMedia.astro'
import FeaturedProjects from '@components/FeaturedProjects.astro'
import FeaturedPosts from '@components/FeaturedPosts.astro'
import CertificatesCarousel from '@components/CertificatesCarousel.astro'
import { Accordion, AccordionItem, Avatar, AvatarGroup, Heading, Link } from 'accessible-astro-components'
import { Icon } from 'astro-icon/components'
import QualitiesIcon from '@assets/icons/qualities.svg';
import HobbiesIcon from '@assets/icons/hobbies.svg';
import SkillsIcon from '@assets/icons/skills.svg';
import SoftwareIcon from '@assets/icons/software.svg';
---

<DefaultLayout title="Portfolio Matías Mellado" useTitleTemplate={false}>
  <Hero />
  <section class="my-24">
    <div class="container">
      <Heading level="h3" class="mb-8">About Me</Heading>
          <div class="desc mb-12">
            <p class="mb-0">Hi! My name is Matías Mellado, though on the internet I go by Arthemy.</p>

            <p class="mb-3">I'm a Technical Game Designer and Senior Unity Developer with a B.A. in Digital 
              Game Design (Magna Cum Laude) and an M.Ed. in Higher Education Teaching (Summa Cum Laude), both 
              from Universidad Andrés Bello (UNAB) in Chile.</p>

            <p class="mb-3">I've worked with Unity since 2017 and since 2022 I've worked professionally as a Unity 
              developer, contributing to published commercial games, educational applications, and numerous game jam 
              prototypes. Since 2020 I've also taught Unity and Game Design at college level, an experience that has 
              strengthened both my technical communication and my passion for mentoring the next generation of developers.</p>

            <p class="mb-3">I'm a high functioning autistic, have ADHD, and have high capacities. These traits have shaped 
              the way I approach game development, leading me to enjoy complex systems design, recognizing patterns across 
              gameplay and code, and diving deeply into technical problems until I find solutions that are robust, maintainable, 
              and intuitive. Rather than something I work around, they've become part of how I think, create, and solve problems.</p>

            <p class="mb-4">Throughout my career, I've naturally ended up working at the intersection of design, engineering, 
              teaching, and tooling. I don't just build games, I also build the systems, tools, and documentation that help games 
              get made. I enjoy turning design ideas into technical solutions, creating tools that make development faster, mentoring 
              other developers, and improving workflows. At the end of the day, I like leaving projects in a better state than I found 
              them and helping the people around me succeed.</p>

            <p class="mb-3">Beyond game development, I have experience with 3D art, animation, video editing, the Adobe Creative Suite, 
              and project management, allowing me to collaborate comfortably across multiple disciplines.</p>

            <p class="mb-3">This portfolio showcases the projects, technical work, and achievements that best represent who I am as a 
              developer. I hope it gives you a good idea of how I think, work, and solve problems.</p>
            </div>
      <div class="grid grid-cols-1 gap-y-16 gap-x-8 md:grid-cols-1 lg:grid-cols-2 2xl:grid-cols-4 ">
        <Feature iconComponent={QualitiesIcon} title="Professional Skills">
          <ul>
            <li>Technical Leadership</li>
            <li>Problem Solving</li>
            <li>Systems Thinking</li>
            <li>Cross-functional Communication</li>
            <li>Creative thinker</li>
            <li>Adaptability</li>
            <li>Mentoring & Teaching</li>
            <li>Team Coordination</li>
        </ul>
        </Feature>
        <Feature iconComponent={SkillsIcon} title="Technical Skills">
          <div class="skills-grid">
            <div>
              <h4>Core</h4>
              <ul>
                <li>Game Design</li>
                <li>Unity Engine</li>
                <li>C# for Unity</li>
                <li>Unity Editor Scripting</li>
                <li>Tools Development</li>
                <li>Agile Development</li>
                <li>Git</li>
              </ul>
            </div>

            <div class="secondary">
              <h4>Supporting</h4>
              <ul>
                <li>Video Editing</li>
                <li>3D Modeling</li>
                <li>3D Texturing</li>
                <li>3D Animation</li>
                <li>2D Image Editing</li>
                <li>2D Animation</li>
                <li>Vector Ilustration</li>
                <li>HTML & CSS</li>
              </ul>
            </div>
          </div>
        </Feature>
        <Feature iconComponent={SoftwareIcon} title="Software">
          <div class="skills-grid">
            <div>
              <h4>Core</h4>
              <h5>Game Development:</h5>
              <ul>
                <li>Unity Engine</li>
                <li>JetBrains Rider(main IDE)</li>
                <li>Git interfaces (GitHub, GitKraken, SourceTree)</li>
              </ul>
              <h5>Productivity:</h5>
              <ul>
                <li>Google Drive suit</li>
                <li>Office Suit</li>
                <li>Miro</li>
              </ul>
            </div>

            <div class="secondary">
              <h4>Supporting</h4>
              <h5>Code:</h5>
              <ul>
                <li>Visual Studio</li>
                <li>VS Code</li>
              </ul>
              <h5>Media:</h5>
              <ul>
                <li>Davinci Resolve</li>
                <li>Adobe Premiere</li>
                <li>Adobe After Effects</li>
              </ul>
              <h5>3D Modeling:</h5>
              <ul>
                <li>Blender</li>
                <li>Substance Painter</li>
              </ul>
              <h5>2D Design:</h5>
              <ul>
                <li>Affinity</li>
                <li>Adobe Photoshop</li>
                <li>Adobe Illustrator</li>
              </ul>
              <h5>Audio:</h5>
              <ul>
                <li>Adobe Audition</li>
                <li>Reaper</li>
                <li>Audacity</li>
              </ul>
            </div>
          </div>
        </Feature>
        <Feature iconComponent={HobbiesIcon} title="Miscellaneous">
          <div class="skills-grid">
            <div>
              <h4>Language</h4>
              <ul>
                <li>Spanish - Native</li>
                <li>English - C2 level</li>
                <li>French - Basic</li>
              </ul>
            </div>
            <div class="secondary">
              <h4>Hobbies</h4>
              <ul>
                <li>Video games (obviously)</li>
                <li>HEMA</li>
                <li>Movies and series</li>
                <li>Books and comics</li>
                <li>Chess</li>
                <li>Tabletop games</li>
                <li>Model kit building</li>
                <li>Piano</li>
              </ul>
            </div>
          </div>
        </Feature>
      </div>
    </div>
  </section>
  <section>
    <div class="container">
      <Heading level="h3">Professional Experience</Heading>
    </div>
  </section>
  <ContentMedia imgSrc="/assets/images/roles/FundaK.jpg" imgHref="https://fundacioncapital.org/soluciones-digitales/lista/" imgTarget="_blank">
    <Heading level="h4">Lead 2D Unity Developer and Technical Designer</Heading>
    <p class="text-2xl">
      Supported multiple educational applications, coordinating cross-team feature delivery and implementation. 
      Designed learning activities aligned with educational and technical requirements while improving internal 
      tools for content integration, optimizing Unity localization and Addressables workflows.
    <!-- <Link isExternal href="https://play.google.com/store/apps/details?id=org.fundacioncapital.listaplus">View on play store</Link> -->
    </p>
  </ContentMedia>
  <ContentMedia imgSrc="/assets/images/roles/store_capsule_main.png" imgHref="https://store.steampowered.com/app/2268250/Hoping_Forest/" imgTarget="_blank"  reverseImg={true}>
    <Heading level="h4">3D Unity Developer</Heading>
    <p class="text-2xl">
      Designed and developed a complete puzzle game independently, taking responsibility for every stage 
      of development from concept to release. Created gameplay systems, puzzles, progression, UI, and 
      supporting tools while continuously iterating on the player experience.
    </p>
  </ContentMedia>
  <ContentMedia imgSrc="/assets/images/roles/minegeon.png" imgHref="https://kickstonestudio.com/our-games" imgTarget="_blank">
    <Heading level="h4">Lead 2D Unity Developer and Technical Designer</Heading>
    <p class="text-2xl">
      Developed gameplay systems, UI, backend integrations, and internal tools for a live mobile game. 
      Built a ScriptableObject-driven content pipeline with custom editor tools, integrated Firebase, ads, 
      and in-app purchases, and mentored an intern while training my successor.
    </p>
  </ContentMedia>
    <ContentMedia imgSrc="/assets/images/roles/SumaYSigueAula.jpg" imgHref="https://cmmedu.uchile.cl/innovaciones-para-el-aula/recursos-para-el-aula/" imgTarget="_blank" reverseImg={true}>
    <Heading level="h4">Internship 2D Unity Development</Heading>
    <p class="text-2xl">
      Implemented educational minigames in Unity based on predefined game designs and teaching materials. Focused on translating 
      design specifications into polished gameplay while building reusable systems using ScriptableObjects within a multidisciplinary development environment.
    </p>
  </ContentMedia>
  <FeaturedProjects limit={4} items={["project-01", "project-05", "project-06", "project-07"]} />
  <!-- <FeaturedPosts /> -->

  <CertificatesCarousel title="Degrees" category="degree" carousel={false}/>
  <CertificatesCarousel title="Certifications" category="certificate" carousel={false} />
  <CertificatesCarousel title="Online Courses" category="course" filterable={true} />
