---
import DefaultLayout from '@layouts/DefaultLayout.astro'
import PageHeader from '@components/PageHeader.astro'
import { Badge, Card, Heading, Link, Pagination } from 'accessible-astro-components'
import { getCollection } from 'astro:content'
import type { GetStaticPaths, Page } from 'astro'
import type { CollectionEntry } from 'astro:content'
import { slugify } from '@utils/slugify'


export const getStaticPaths = (async ({ paginate }) => {
  const projects = await getCollection('projects')
  const allTags = projects.map((project) => project.data.skills).flat()
  const uniqueTagLabels = [...new Set(allTags)].sort((a, b) => a.localeCompare(b))
  const uniqueTags = uniqueTagLabels.map((label) => ({
    label,
    slug: slugify(label),
  }))

  const projectsWithImages = projects.map((project, index) => {
    return {
      ...project,
      featuredImage: project.data.featuredImage,  //projectImages[index % projectImages.length],
    }
  })

  return paginate(projectsWithImages, {
    pageSize: 9,
    props: { uniqueTags },
  })
}) satisfies GetStaticPaths

interface Props {
  page: Page<CollectionEntry<'projects'> & { featuredImage: any }>
  uniqueTags: { label: string; slug: string }[]
}

const { page, uniqueTags } = Astro.props
---

<DefaultLayout
  title="Projects"
  description="Highlighted projects I've worked on. It includes previous works, personal project and freelance works"
>
  <PageHeader
    title="Projects"
    subtitle="Highlighted projects I've worked on. It includes previews roles, personal project and freelance works."
    bgType="bordered"
  />
  <section class="my-12">
    <div class="container">
      <Heading level="h2" size="h5" class="mb-2">Skills</Heading>
      <div class="flex flex-wrap gap-4">
        {
          uniqueTags.map((tag: { label: string; slug: string }) => (
            <Link href={'/projects/tag/' + tag.slug}>{tag.label}</Link>
          ))
        }
      </div>
      <p class="mt-8 text-sm">
        <em>Project {page.start + 1} through {page.end + 1} of {page.total} total projects</em>
      </p>
      <ul class="mt-3 grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
        {
          page.data.map((project) => (
            <li>
              <Card
                imageComponent={project.featuredImage}
                url={'/projects/' + project.id}
                title={project.data.title}
                headingLevel="h2"
                footer={'Skills: ' + project.data.skills.join(', ')}
                fullHeight={true}
              >
                <span slot="meta">
                  {project.data.skills.map((skill) => (
                    <Badge>{skill}</Badge>
                  ))}
                </span>
                {project.data.description}
              </Card>
            </li>
          ))
        }
      </ul>
      {
        page && page.lastPage > 1 && (
          <div class="mt-12 grid place-content-center">
            <Pagination
              firstPage={page.url.prev ? '/projects' : null}
              previousPage={page.url.prev ? page.url.prev : null}
              nextPage={page.url.next ? page.url.next : null}
              lastPage={page.url.next ? `/projects/${page.lastPage}` : null}
              currentPage={`${page.currentPage}`}
              totalPages={`${page.lastPage}`}
              ariaLabel="Projects pagination"
            />
          </div>
        )
      }
    </div>
  </section>
</DefaultLayout>

<style>
  :global(nav.pagination .list) {
    display: flex !important;
    flex-direction: row !important;
    flex-wrap: nowrap !important;
    align-items: center;
    gap: 1rem;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  :global(nav.pagination .list li) {
    display: flex;
    align-items: center;
  }
</style>
