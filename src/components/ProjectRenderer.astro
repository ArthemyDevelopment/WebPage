---
import type { CollectionEntry } from 'astro:content'
import { Link } from 'accessible-astro-components'


interface Props {
  project: CollectionEntry<'projects'>['data']
}

const { project } = Astro.props


---

{project.displayMode === 'embed' && (
<div class="embed-container">
  <iframe
      src={`https://itch.io/${project.itchId}`}
      title={`Play ${project.title}`}
      width="1280"
      height="750"
      frameborder="0"
      allowfullscreen
      loading="lazy"
  >
    <a href={`https://itch.io/${project.itchId.split('?')[0]}`}>
      Play {project.title} on itch.io
    </a>
  </iframe>
</div>
)}
<div class="embed-message">
  <p>This game is only available on desktop. Please view this page on a larger screen.</p>
</div>

{project.displayMode === 'media' && (
  <div class="aspect-video w-full overflow-hidden rounded-box bg-base-300">
    <video
      class="h-full w-full object-cover"
      src={project.videoUrl}
      controls
      preload="metadata"
      title={`${project.title} trailer`}
    />
  </div>
)}

{project.displayMode === 'link' && (
  <div class="flex justify-center py-8">
    <Link href={project.externalUrl} isExternal isButton>
      Play on store
    </Link>
  </div>
)}

{
  project.skills.length > 0 && (
    <div class="mt-4 flex flex-wrap gap-2">
      {project.skills.map((skill) => (
        <span class="badge badge-outline">{skill}</span>
      ))}
    </div>
  )

}

<style>
  .embed-container {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
  }
  

  .embed-message {
    text-align: center;
    color: var(--text-color);
    margin-top: 1rem;
    font-size: larger;
    font-weight:bold;
  }
@media (min-width: 1025px)
{
  .embed-container iframe{
    display:flex !important;
  }
  
  .embed-message {
    display: none !important;
  }
}
  @media (max-width: 1024px) {
    .embed-container iframe{
      display: none !important;
    }

    .embed-message {
      display: block !important;
    }
  }
  
</style>
