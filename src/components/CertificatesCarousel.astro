---
import { Badge, Heading, Link } from 'accessible-astro-components'
import { Image } from 'astro:assets'
import { credentials } from '@data/credentials'
import type { Credential } from '@data/credentials'

/**
 * CertificatesCarousel Component
 *
 * @description A daisyUI carousel of credential cards (https://daisyui.com/components/carousel/,
 * https://daisyui.com/components/card/), reading from the static `credentials` list in
 * src/data/credentials.ts. Reusable for certificates, diplomas, or degrees:
 *
 *   <CertificatesCarousel title="Certificates" category="certificate" filterable />
 *   <CertificatesCarousel title="Diplomas" category="diploma" />
 *   <CertificatesCarousel title="Degrees" category="degree" />
 *
 * Prev/next navigation uses daisyUI's native anchor-based carousel (no JS). The only
 * custom script here handles the optional tag filter bar. Entries are sorted by
 * featured -> priority -> date automatically, so the data file order doesn't matter
 * unless you pass an explicit `items` list.
 */
interface Props {
  class?: string
  title?: string
  /** Only include credentials of this category */
  category?: Credential['category']
  /** Only include credentials with at least one of these tags (lowercase) */
  tags?: string[]
  /** Only include these specific ids, in this exact order (overrides category/tags/auto-sort) */
  items?: string[]
  /** Only include credentials marked `featured: true` */
  featuredOnly?: boolean
  /** Render an "All / tag / tag / ..." filter bar above the carousel, built from the resulting items' tags */
  filterable?: boolean
  carousel?: boolean
  limit?: number
}

const {
  class: className,
  title = 'Certificates',
  category,
  tags,
  items,
  featuredOnly = false,
  filterable = false,
  carousel = true,
  limit,
} = Astro.props

const capitalize = (s: string) => s.charAt(0).toUpperCase() + s.slice(1)

let list: Credential[]

if (items) {
  // Explicit order requested: honor it as-is, no auto-sort.
  list = items.map((id) => credentials.find((c) => c.id === id)).filter((c): c is Credential => Boolean(c))
} else {
  list = credentials.filter((c) => {
    if (category && c.category !== category) return false
    if (tags?.length && !c.tags.some((t) => tags.includes(t))) return false
    if (featuredOnly && !c.featured) return false
    return true
  })

  list.sort(
    (a, b) =>
      Number(b.featured ?? false) - Number(a.featured ?? false) ||
      (b.priority ?? 0) - (a.priority ?? 0) ||
      (b.date?.getTime() ?? 0) - (a.date?.getTime() ?? 0)
  )
}

if (limit) list = list.slice(0, limit)

const uniqueTags = filterable ? [...new Set(list.flatMap((c) => c.tags))].sort((a, b) => a.localeCompare(b)) : []
const slideId = (id: string) => `slide-${id}`
---

{
  list.length > 0 && (
    <section class:list={[className, 'my-24']}>
      <div class="container" data-carousel-section>
        <Heading level="h3" class="mb-6">
          {title}
        </Heading>

        {filterable && uniqueTags.length > 0 && (
          <div class="mb-6 flex flex-wrap gap-2" role="group" aria-label={`Filter ${title} by tag`}>
            <button type="button" class="btn btn-sm btn-tag" data-tag-filter="all" aria-pressed="true">
              All
            </button>
            {uniqueTags.map((tag) => (
              <button type="button" class="btn btn-sm btn-tag-outline" data-tag-filter={tag} aria-pressed="false">
                {capitalize(tag)}
              </button>
            ))}
          </div>
        )}

        <div class="relative w-full">

          {carousel && (<button class="btn btn-circle absolute left-0 top-1/2 z-20 -translate-y-1/2" data-nav="prev" aria-label="Previous item">❮</button>)}

          <div class="carousel carousel-center w-full gap-6 scroll-smooth overflow-x-auto" data-carousel>
            {list.map((credential, index) => {
              
              const cardBody = (
                <div class="card-body">
                  {/*credential.logo && (
                    <Image src={credential.logo} alt="" width={96} height={96} class="mb-2 h-8 w-8 object-contain" />
                  )*/}
                  <div class="card-body-info">
                    <h3 class="card-title">{credential.title}</h3>
                    {credential.issuer && (
                      <p class="text-sm opacity-70">
                        {credential.issuer}
                        {credential.date && ` · ${credential.date.getFullYear()}`}
                      </p>
                    )}
                    {credential.description && <p>{credential.description}</p>}
                    {credential.tags.length > 0 && (
                      <div class="badges">
                        {credential.tags.map((tag) => (
                          <Badge>{capitalize(tag)}</Badge>
                        ))}
                      </div>
                    )}
                  </div>
                </div>
              )

              return (
                <div
                  id={slideId(credential.id)}
                  class="carousel-item relative w-full max-w-sm"
                  data-carousel-item
                  data-tags={credential.tags.join('|')}
                >
                  <div class="card w-full shadow-sm">
                    {credential.credentialUrl ? (
                      <a href={credential.credentialUrl} class="contents" aria-label={credential.title} target="_blank" rel="noopener">
                        {cardBody}
                      </a>
                    ) : (
                      cardBody
                    )}

                    <button
                      type="button"
                      class="w-full h-auto p-0 border-0 bg-transparent cursor-pointer"
                      data-lightbox-image={credential.id}
                      aria-label={`View full size image of ${credential.title}`}>
                      <figure>
                        <Image
                          src={credential.image}
                          alt={credential.title}
                          width={480}
                          class="w-full h-auto"
                        />
                      </figure>
                    </button>

                    {credential.verificationUrl && (
                      <Link href={credential.verificationUrl} isExternal class="btn btn-soft w-auto">
                        Verify online
                      </Link>
                    )}
                  </div>
                </div>
              )
            })}
          </div>


          {carousel && (<button class="btn btn-circle absolute right-0 top-1/2 z-20 -translate-y-1/2" data-nav="next" aria-label="Next item">❯</button>

          <div class="mt-8 w-full max-w-sm mx-auto bg-gray-200 h-2 rounded-full overflow-hidden" data-indicator>
            <div class="bg-primary h-full w-0 transition-all duration-300 progress-fill"></div>
          </div>)}

        </div>
        <div class="lightbox hidden" data-lightbox>
          <button
            class="lightbox-backdrop"
            type="button"
            data-lightbox-close
            aria-label="Close image"
          ></button>

          <div class="lightbox-content md:translate-x-20 lg:translate-x-28">
            <button
              class="btn btn-circle absolute top-4 right-4 z-20"
              type="button"
              data-lightbox-close>
              ✕
            </button>

            {list.map((credential) => (
              <Image
                src={credential.image}
                alt={credential.title}
                width={1400}
                class="hidden max-h-[70vh] max-w-[50vw] object-contain"
                data-lightbox-target={credential.id}
              />
            ))}
          </div>
        </div>
        

      </div>  
    </section>
  )
}

<script>

  function initCarousel(){
  // Only needed for the optional tag filter bar — carousel navigation is pure daisyUI/CSS.
  document.querySelectorAll<HTMLElement>('[data-carousel-section]').forEach((section) => {
    const buttons = section.querySelectorAll<HTMLButtonElement>('[data-tag-filter]')
    const items = section.querySelectorAll<HTMLElement>('[data-carousel-item]')
      
    const progressBar = section.querySelector<HTMLElement>('[data-indicator]');

    const lightbox = section.querySelector<HTMLElement>('[data-lightbox]');

    section.querySelectorAll<HTMLButtonElement>('[data-lightbox-image]').forEach((button) => {
      button.addEventListener('click', () => {
        if (!lightbox) return;

        lightbox.classList.remove('hidden');

        lightbox
          .querySelectorAll<HTMLElement>('[data-lightbox-target]')
          .forEach((img) => img.classList.add('hidden'));

        lightbox
          .querySelector<HTMLElement>(
            `[data-lightbox-target="${button.dataset.lightboxImage}"]`
          )
          ?.classList.remove('hidden');

        document.body.style.overflow = 'hidden';
      });
    });

    lightbox?.querySelectorAll('[data-lightbox-close]').forEach((button) => {
      button.addEventListener('click', () => {
        lightbox.classList.add('hidden');
        document.body.style.overflow = '';
      });
    });

    buttons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const tag = btn.dataset.tagFilter ?? 'all'

        if(carousel){
          carousel.scrollTo({left: 0, behavior: "smooth"});
          const bar = progressBar?.querySelector('.progress-fill');
          if(bar instanceof HTMLElement) bar.style.width= '0%';
        
        }        

        buttons.forEach((b) => {
          const active = b === btn
          b.setAttribute('aria-pressed', String(active))
          b.classList.toggle('btn-tag', active)
          b.classList.toggle('btn-tag-outline', !active)
        })

        items.forEach((item) => {
          const itemTags = (item.dataset.tags ?? '').split('|')
          item.classList.toggle('hidden', !(tag === 'all' || itemTags.includes(tag)))
        })
      })
    })

    const carousel = section.querySelector<HTMLElement>('[data-carousel]');
    const navButtons = section.querySelectorAll<HTMLButtonElement>('[data-nav]');
    const firstItem = carousel?.querySelector<HTMLElement>('.carousel-item');

    if (!carousel || !firstItem) return;

    navButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const dir = btn.dataset.nav === 'next' ? 1 : -1;
        const itemWidth = (firstItem.offsetWidth + 24); 
        carousel.scrollBy({ left: dir * itemWidth*2, behavior: 'smooth' });
      });
    });

    let ticking = false;

    carousel.addEventListener('scroll', () => {
      if (!ticking) {
        window.requestAnimationFrame(() => {
          const scrollRatio = carousel.scrollLeft / (carousel.scrollWidth - carousel.clientWidth);
          const percentage = Math.min(Math.max(scrollRatio * 100, 0), 100);
          
          const bar = progressBar?.querySelector('.progress-fill');
          if (bar instanceof HTMLElement) {
            bar.style.width = `${percentage}%`;
          }
          ticking = false;
        });
        ticking = true;
      }
    });
  });
}

initCarousel();

document.addEventListener('astro:page-load', initCarousel);
</script>

<style lang="scss">


.btn-tag {
    --btn-color: var(--link-color);
    --btn-fg: var(--launcher-theme-light);
    --btn-soft-bg: initial;
  
}
:global(.darkmode .btn-tag) {
    --btn-color: var(--link-color);
    --btn-fg: var(--launcher-theme-dark);
    --btn-soft-bg: initial;
  
}

.btn-tag-outline {
    --btn-bg: #0000;
    color: var(--btn-rest-fg, var(--btn-color, var(--link-color)));
    --btn-border: var(--btn-color, var(--link-color));
    --btn-border-style: dashed;
    background-image: none;
    --btn-inset: 0 0 0 0 oklch(0% 0 0 / 0);
    --btn-shadow: 0 0 0 0 oklch(0% 0 0 / 0);

  
}

/* :global() because this class ends up on the <a> rendered inside the
   imported <Link> component, which is outside this file's style scope —
   Astro's scoped CSS can't reach it otherwise. */
:global(.btn-soft){
  --btn-bg: #FFE0C5;
  --btn-border: var(--launcher-theme-light);
}

:global(.darkmode .btn-soft){
  --btn-bg: #723eb3;
  --btn-border: var(--launcher-theme-dark);
}

/* The Link component may ship its own anchor defaults (underline, inline
   display, link-colored text). Force it back to looking like a daisyUI
   btn regardless of what Link applies by default. */
:global(a.btn.btn-soft) {
  text-decoration: none;
  display: inline-flex;
  align-items: center;
  justify-content: center;
}

.card{
  background-color: var(--color-neutral-100);
  height: fit-content;
}


.card-body .card-title{
  line-height: unset
}

.card-body .card-body-info{
  height:12rem;
  overflow-y: auto;
  display: flex;
  flex-direction: column;
}

.card-body .card-body-info .badges{
  margin-top: auto;
  display: flex;
  flex-wrap: wrap;
  gap: calc(var(--spacing) * 2) /* 0.5rem = 8px */;

}

.progress-fill{
  transition:width 01s ease-out;
}

[data-indicator] {
  .bg-primary{
    background-color: var(--link-color);
  }
}


:global(.darkmode .card) {
        background-color: var(--color-neutral-900);
        height: fit-content;
}

  .lightbox {
  position: fixed;
  inset: 0;
  z-index: 9999;

  display: flex;
  justify-content: center;
  align-items: center;
}

.lightbox.hidden {
  display: none;
}

.lightbox-backdrop {
  position: absolute;
  inset: 0;
  border: 0;
  background: rgb(0 0 0 / 80%);
  cursor: pointer;
}

.lightbox-content {
  position: relative;
  z-index: 1;

  display: flex;
  justify-content: center;
  align-items: center;
}

</style>
