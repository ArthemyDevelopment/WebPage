---
import { Media } from 'accessible-astro-components'

/**
 * ContentMedia Component
 *
 * @description A component that displays content alongside media, with the option to reverse the image position
 */
interface Props {
  /**
   * The source URL for the image
   */
  imgSrc: string
  /**
   * Whether to display the image on the right side instead of the left
   * @default false
   */
  reverseImg?: boolean
  imgHref?: string 
  imgTarget?: "_blank" | "_self" 
}

const { imgSrc, reverseImg = false, imgHref, imgTarget }: Props = Astro.props
---


<section class="my-24">
  <div class="container">
    <div class="grid grid-cols-1 gap-x-12 md:grid-cols-2">
      {!reverseImg ? (
  imgHref ? (
    <a href={imgHref} target={imgTarget} rel={imgTarget === "_blank" ? "noopener noreferrer" : undefined}>
      <Media class="rounded-xl" src={imgSrc} />
    </a>
  ) : (
    <Media class="rounded-xl" src={imgSrc} />
  )
) : ''}
      <div class="space-content flex flex-col justify-center">
        <slot />
      </div>
      {reverseImg ? (
  imgHref ? (
    <a href={imgHref} target={imgTarget} rel={imgTarget === "_blank" ? "noopener noreferrer" : undefined}>
      <Media class="rounded-xl" src={imgSrc} />
    </a>
  ) : (
    <Media class="rounded-xl" src={imgSrc} />
  )
) : ''}
    </div>
  </div>
</section>
